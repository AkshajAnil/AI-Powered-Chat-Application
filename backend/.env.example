# Server
PORT=5000
HOST=0.0.0.0

# Comma separated list of allowed browser origins ("*" allows any origin).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Storage driver: postgres (recommended) | sqlite | file
DB_DRIVER=postgres

# --- PostgreSQL (used when DB_DRIVER=postgres) ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change-me
PGDATABASE=Chat-Application
PG_POOL_MAX=10

# --- SQLite / file fallback (used when DB_DRIVER=sqlite|file) ---
DATABASE_PATH=./data/chat.db

# Logging: debug | info | warn | error | silent
LOG_LEVEL=info

# --- AI agents (Groq) ---
# Get a key at https://console.groq.com/keys - without it agents reply with a hint.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.7
