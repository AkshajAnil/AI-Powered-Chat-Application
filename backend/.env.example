# Server
PORT=5000
HOST=0.0.0.0

# Comma separated list of allowed browser origins ("*" allows any origin).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Storage driver: redis (recommended) | postgres | sqlite | file
DB_DRIVER=redis

# --- Redis (used when DB_DRIVER=redis) ---
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=chatapp

# --- PostgreSQL (used when DB_DRIVER=postgres) ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change-me
PGDATABASE=Chat-Application
PG_POOL_MAX=10

# --- SQLite / file fallback (used when DB_DRIVER=sqlite|file) ---
DATABASE_PATH=./data/chat.db

# Logging: debug | info | warn | error | silent
LOG_LEVEL=info

# JWT signing key (use a unique random value of at least 32 characters outside local development).
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Created in the configured database on first start if the username does not exist.
SEED_USERNAME=pilot_user
SEED_PASSWORD=1234

# --- AI agents (Groq) ---
# Get a key at https://console.groq.com/keys - without it agents reply with a hint.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.7
